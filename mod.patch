diff -ruN a/TMessagesProj/src/main/java/org/telegram/ui/ModSettingsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ModSettingsActivity.java
--- a/TMessagesProj/src/main/java/org/telegram/ui/ModSettingsActivity.java	1970-01-01 00:00:00.000000000 +0000
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ModSettingsActivity.java	2026-11-11 03:10:26.293647908 +0000
@@ -0,0 +1,217 @@
+package org.telegram.ui;
+
+import android.content.Context;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.ModConfig;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Cells.HeaderCell;
+import org.telegram.ui.Cells.TextCheckCell;
+import org.telegram.ui.Cells.TextInfoPrivacyCell;
+import org.telegram.ui.Cells.TextSettingsCell;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.RecyclerListView;
+
+/** Экран «Настройки мода». */
+public class ModSettingsActivity extends BaseFragment {
+
+    private static final int TYPE_HEADER = 0;
+    private static final int TYPE_CHECK = 1;
+    private static final int TYPE_INFO = 2;
+    private static final int TYPE_VALUE = 3;
+
+    private static final int ROW_PRIVACY_HEADER = 0;
+    private static final int ROW_NO_TYPING = 1;
+    private static final int ROW_CONFIRM_CALLS = 2;
+    private static final int ROW_PRIVACY_INFO = 3;
+    private static final int ROW_UI_HEADER = 4;
+    private static final int ROW_HIDE_PREMIUM = 5;
+    private static final int ROW_HIDE_STARS = 6;
+    private static final int ROW_UI_INFO = 7;
+    private static final int ROW_ABOUT_HEADER = 8;
+    private static final int ROW_VERSION = 9;
+    private static final int ROW_COUNT = 10;
+
+    private RecyclerListView listView;
+    private ListAdapter adapter;
+
+    @Override
+    protected boolean useSimpleActionBar() {
+        return true;
+    }
+
+    @Override
+    public View createView(Context context) {
+        setHasOwnBackground(true);
+        simpleActionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        simpleActionBar.setTitle(LocaleController.getString(R.string.ModSettings));
+        simpleActionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                }
+            }
+        });
+
+        FrameLayout frameLayout = new FrameLayout(context);
+        fragmentView = frameLayout;
+
+        listView = new RecyclerListView(context);
+        listView.setSectionsDrawBackground(true);
+        listView.setSections();
+        listView.setLayoutManager(new LinearLayoutManager(context));
+        listView.setVerticalScrollBarEnabled(false);
+        listView.setAdapter(adapter = new ListAdapter(context));
+        listView.setOnItemClickListener((view, position) -> onRowClicked(view, position));
+        frameLayout.addView(listView, LayoutHelper.createFrame(
+                LayoutHelper.MATCH_PARENT,
+                LayoutHelper.MATCH_PARENT
+        ));
+        return fragmentView;
+    }
+
+    private static String keyFor(int position) {
+        switch (position) {
+            case ROW_NO_TYPING: return ModConfig.KEY_NO_TYPING;
+            case ROW_CONFIRM_CALLS: return ModConfig.KEY_CONFIRM_CALLS;
+            case ROW_HIDE_PREMIUM: return ModConfig.KEY_HIDE_PREMIUM;
+            case ROW_HIDE_STARS: return ModConfig.KEY_HIDE_STARS;
+        }
+        return null;
+    }
+
+    private void onRowClicked(View view, int position) {
+        String key = keyFor(position);
+        if (key != null && view instanceof TextCheckCell) {
+            boolean value = ModConfig.toggle(key);
+            ((TextCheckCell) view).setChecked(value);
+        }
+    }
+
+    private class ListAdapter extends RecyclerListView.SelectionAdapter {
+        private final Context context;
+
+        private ListAdapter(Context context) {
+            this.context = context;
+        }
+
+        @Override
+        public int getItemCount() {
+            return ROW_COUNT;
+        }
+
+        @Override
+        public boolean isEnabled(RecyclerView.ViewHolder holder) {
+            return holder.getItemViewType() == TYPE_CHECK;
+        }
+
+        @NonNull
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            View view;
+            if (viewType == TYPE_HEADER) {
+                view = new HeaderCell(context);
+            } else if (viewType == TYPE_CHECK) {
+                view = new TextCheckCell(context);
+            } else if (viewType == TYPE_VALUE) {
+                view = new TextSettingsCell(context);
+            } else {
+                view = new TextInfoPrivacyCell(context);
+            }
+            view.setLayoutParams(new RecyclerView.LayoutParams(
+                    RecyclerView.LayoutParams.MATCH_PARENT,
+                    RecyclerView.LayoutParams.WRAP_CONTENT
+            ));
+            return new RecyclerListView.Holder(view);
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+            switch (holder.getItemViewType()) {
+                case TYPE_HEADER: {
+                    HeaderCell cell = (HeaderCell) holder.itemView;
+                    if (position == ROW_PRIVACY_HEADER) {
+                        cell.setText(LocaleController.getString(R.string.ModHeaderPrivacy));
+                    } else if (position == ROW_UI_HEADER) {
+                        cell.setText(LocaleController.getString(R.string.ModHeaderInterface));
+                    } else {
+                        cell.setText(LocaleController.getString(R.string.ModHeaderAbout));
+                    }
+                    break;
+                }
+                case TYPE_CHECK: {
+                    TextCheckCell cell = (TextCheckCell) holder.itemView;
+                    String key = keyFor(position);
+                    int title;
+                    boolean divider = true;
+                    if (position == ROW_NO_TYPING) {
+                        title = R.string.ModNoTyping;
+                    } else if (position == ROW_CONFIRM_CALLS) {
+                        title = R.string.ModConfirmCalls;
+                        divider = false;
+                    } else if (position == ROW_HIDE_PREMIUM) {
+                        title = R.string.ModHidePremium;
+                    } else {
+                        title = R.string.ModHideStars;
+                        divider = false;
+                    }
+                    cell.setTextAndCheck(LocaleController.getString(title), ModConfig.get(key), divider);
+                    break;
+                }
+                case TYPE_VALUE: {
+                    TextSettingsCell cell = (TextSettingsCell) holder.itemView;
+                    cell.setTextAndValue(LocaleController.getString(R.string.ModVersion), ModConfig.MOD_VERSION, false);
+                    break;
+                }
+                default: {
+                    TextInfoPrivacyCell cell = (TextInfoPrivacyCell) holder.itemView;
+                    if (position == ROW_PRIVACY_INFO) {
+                        cell.setText(LocaleController.getString(R.string.ModPrivacyInfo));
+                    } else {
+                        cell.setText(LocaleController.getString(R.string.ModInterfaceInfo));
+                    }
+                    break;
+                }
+            }
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            switch (position) {
+                case ROW_PRIVACY_HEADER:
+                case ROW_UI_HEADER:
+                case ROW_ABOUT_HEADER:
+                    return TYPE_HEADER;
+                case ROW_NO_TYPING:
+                case ROW_CONFIRM_CALLS:
+                case ROW_HIDE_PREMIUM:
+                case ROW_HIDE_STARS:
+                    return TYPE_CHECK;
+                case ROW_VERSION:
+                    return TYPE_VALUE;
+                default:
+                    return TYPE_INFO;
+            }
+        }
+    }
+
+    @Override
+    protected RecyclerListView getListViewForSimpleGlass() {
+        return listView;
+    }
+
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
+}
