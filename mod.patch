diff -ruN a/TMessagesProj/src/main/java/org/telegram/messenger/ModConfig.java b/TMessagesProj/src/main/java/org/telegram/messenger/ModConfig.java
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ModConfig.java	1970-01-01 00:00:00.000000000 +0000
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ModConfig.java	2026-11-11 05:34:32.415549765 +0000
@@ -0,0 +1,127 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Настройки мода. Хранятся в отдельном SharedPreferences-файле "modconfig". */
+public class ModConfig {
+
+    public static final String MOD_VERSION = "1.1";
+
+    public static final int STYLE_DEFAULT = 0;
+    public static final int STYLE_MATERIAL3 = 1;
+    public static final int STYLE_GLASS = 2;
+
+    private static final String PREFS = "modconfig";
+
+    public static final String KEY_NO_TYPING = "no_typing_status";
+    public static final String KEY_CONFIRM_CALLS = "confirm_calls";
+    public static final String KEY_HIDE_PREMIUM = "hide_premium";
+    public static final String KEY_HIDE_STARS = "hide_stars";
+    public static final String KEY_LOCAL_PREMIUM = "local_premium";
+    public static final String KEY_SAVE_DELETED = "save_deleted";
+    public static final String KEY_NO_READ = "no_read_receipts";
+    private static final String KEY_STYLE = "ui_style";
+
+    private static volatile boolean loaded;
+    private static volatile boolean noTyping;
+    private static volatile boolean confirmCalls;
+    private static volatile boolean hidePremium;
+    private static volatile boolean hideStars;
+    private static volatile boolean localPremium;
+    private static volatile boolean saveDeleted;
+    private static volatile boolean noRead;
+    private static volatile int style;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static synchronized void load() {
+        if (loaded) {
+            return;
+        }
+        SharedPreferences p = prefs();
+        noTyping = p.getBoolean(KEY_NO_TYPING, false);
+        confirmCalls = p.getBoolean(KEY_CONFIRM_CALLS, false);
+        hidePremium = p.getBoolean(KEY_HIDE_PREMIUM, false);
+        hideStars = p.getBoolean(KEY_HIDE_STARS, false);
+        localPremium = p.getBoolean(KEY_LOCAL_PREMIUM, false);
+        saveDeleted = p.getBoolean(KEY_SAVE_DELETED, false);
+        noRead = p.getBoolean(KEY_NO_READ, false);
+        style = p.getInt(KEY_STYLE, STYLE_DEFAULT);
+        loaded = true;
+    }
+
+    public static boolean get(String key) {
+        load();
+        switch (key) {
+            case KEY_NO_TYPING: return noTyping;
+            case KEY_CONFIRM_CALLS: return confirmCalls;
+            case KEY_HIDE_PREMIUM: return hidePremium;
+            case KEY_HIDE_STARS: return hideStars;
+            case KEY_LOCAL_PREMIUM: return localPremium;
+            case KEY_SAVE_DELETED: return saveDeleted;
+            case KEY_NO_READ: return noRead;
+        }
+        return false;
+    }
+
+    public static boolean toggle(String key) {
+        load();
+        boolean value = !get(key);
+        switch (key) {
+            case KEY_NO_TYPING: noTyping = value; break;
+            case KEY_CONFIRM_CALLS: confirmCalls = value; break;
+            case KEY_HIDE_PREMIUM: hidePremium = value; break;
+            case KEY_HIDE_STARS: hideStars = value; break;
+            case KEY_LOCAL_PREMIUM: localPremium = value; break;
+            case KEY_SAVE_DELETED: saveDeleted = value; break;
+            case KEY_NO_READ: noRead = value; break;
+            default: return false;
+        }
+        prefs().edit().putBoolean(key, value).apply();
+        return value;
+    }
+
+    public static int getStyle() {
+        load();
+        return style;
+    }
+
+    /**
+     * Переключает стиль интерфейса. Liquid Glass включается через штатные флаги LiteMode
+     * (прежнее состояние флагов запоминается и возвращается при выходе из стиля).
+     * Material 3 включает палитру Material You (Android 12+), см. {@link ModTheme}.
+     */
+    public static void applyStyle(int newStyle) {
+        load();
+        int old = style;
+        if (old == newStyle) {
+            return;
+        }
+        SharedPreferences.Editor e = prefs().edit();
+        if (newStyle == STYLE_GLASS && old != STYLE_GLASS) {
+            e.putBoolean("glass_prev", LiteMode.isEnabledSetting(LiteMode.FLAG_LIQUID_GLASS));
+            e.putBoolean("blur_prev", LiteMode.isEnabledSetting(LiteMode.FLAG_CHAT_BLUR));
+            LiteMode.toggleFlag(LiteMode.FLAG_LIQUID_GLASS, true);
+            LiteMode.toggleFlag(LiteMode.FLAG_CHAT_BLUR, true);
+        } else if (old == STYLE_GLASS && newStyle != STYLE_GLASS) {
+            SharedPreferences p = prefs();
+            LiteMode.toggleFlag(LiteMode.FLAG_LIQUID_GLASS, p.getBoolean("glass_prev", false));
+            LiteMode.toggleFlag(LiteMode.FLAG_CHAT_BLUR, p.getBoolean("blur_prev", false));
+        }
+        e.putInt(KEY_STYLE, newStyle).apply();
+        style = newStyle;
+        ModTheme.invalidate();
+    }
+
+    public static boolean isNoTyping() { load(); return noTyping; }
+    public static boolean isConfirmCalls() { load(); return confirmCalls; }
+    public static boolean isHidePremium() { load(); return hidePremium; }
+    public static boolean isHideStars() { load(); return hideStars; }
+    public static boolean isLocalPremium() { load(); return localPremium; }
+    public static boolean isSaveDeleted() { load(); return saveDeleted; }
+    public static boolean isNoRead() { load(); return noRead; }
+    public static boolean isMaterial3() { load(); return style == STYLE_MATERIAL3; }
+}
diff -ruN a/TMessagesProj/src/main/java/org/telegram/messenger/ModDeletedMessages.java b/TMessagesProj/src/main/java/org/telegram/messenger/ModDeletedMessages.java
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ModDeletedMessages.java	1970-01-01 00:00:00.000000000 +0000
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ModDeletedMessages.java	2026-11-11 05:34:32.422470760 +0000
@@ -0,0 +1,86 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import androidx.collection.LongSparseArray;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Хранит список сообщений, удалённых собеседником, но сохранённых у нас
+ * (при включённой функции «Сохранять удалённые сообщения»).
+ * Сами сообщения остаются в обычной базе Telegram, здесь только пометки.
+ */
+public class ModDeletedMessages {
+
+    private static final String PREFS = "mod_deleted_messages";
+    private static final String KEY = "ids";
+    private static final int MAX_ENTRIES = 50000;
+
+    private static Set<String> set;
+
+    private static synchronized Set<String> set() {
+        if (set == null) {
+            SharedPreferences p = ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            set = new HashSet<>(p.getStringSet(KEY, new HashSet<>()));
+        }
+        return set;
+    }
+
+    private static String key(int account, long dialogKey, int id) {
+        return account + "_" + dialogKey + "_" + id;
+    }
+
+    /** dialogKey: 0 для обычных чатов (id сообщений общие), -channelId для каналов и супергрупп. */
+    public static void remember(int account, LongSparseArray<ArrayList<Integer>> deleted) {
+        if (deleted == null) {
+            return;
+        }
+        boolean changed = false;
+        synchronized (ModDeletedMessages.class) {
+            Set<String> s = set();
+            for (int a = 0; a < deleted.size(); a++) {
+                long dialogKey = deleted.keyAt(a);
+                ArrayList<Integer> ids = deleted.valueAt(a);
+                if (ids == null) {
+                    continue;
+                }
+                for (int i = 0; i < ids.size(); i++) {
+                    changed |= s.add(key(account, dialogKey, ids.get(i)));
+                }
+            }
+            if (changed) {
+                if (s.size() > MAX_ENTRIES) {
+                    s.clear();
+                }
+                ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+                        .edit().putStringSet(KEY, new HashSet<>(s)).apply();
+            }
+        }
+        if (changed) {
+            AndroidUtilities.runOnUIThread(() ->
+                    NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.modDeletedMessagesUpdated));
+        }
+    }
+
+    public static void remember(int account, long channelId, ArrayList<Integer> ids) {
+        LongSparseArray<ArrayList<Integer>> map = new LongSparseArray<>();
+        map.put(channelId == 0 ? 0 : -channelId, ids);
+        remember(account, map);
+    }
+
+    public static boolean isDeleted(MessageObject mo) {
+        if (mo == null || mo.messageOwner == null) {
+            return false;
+        }
+        long dialogKey = 0;
+        if (mo.messageOwner.peer_id != null && mo.messageOwner.peer_id.channel_id != 0) {
+            dialogKey = -mo.messageOwner.peer_id.channel_id;
+        }
+        synchronized (ModDeletedMessages.class) {
+            return set().contains(key(mo.currentAccount, dialogKey, mo.getId()));
+        }
+    }
+}
diff -ruN a/TMessagesProj/src/main/java/org/telegram/messenger/ModTheme.java b/TMessagesProj/src/main/java/org/telegram/messenger/ModTheme.java
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ModTheme.java	1970-01-01 00:00:00.000000000 +0000
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ModTheme.java	2026-11-11 05:34:32.418983746 +0000
@@ -0,0 +1,77 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.os.Build;
+import android.util.SparseIntArray;
+
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * Стиль «Material 3»: подменяет ключевые цвета темы цветами системной палитры Material You
+ * (Android 12+). Тона соответствуют ролям M3: primary, primaryContainer, surface и т.д.
+ */
+public class ModTheme {
+
+    private static SparseIntArray light;
+    private static SparseIntArray dark;
+
+    public static synchronized void invalidate() {
+        light = null;
+        dark = null;
+    }
+
+    /** @return цвет или 0, если ключ не переопределяется. */
+    public static int getColor(int key, boolean isDark) {
+        if (Build.VERSION.SDK_INT < 31) {
+            return 0;
+        }
+        SparseIntArray map = isDark ? dark : light;
+        if (map == null) {
+            map = build(isDark);
+        }
+        return map.get(key, 0);
+    }
+
+    private static synchronized SparseIntArray build(boolean isDark) {
+        SparseIntArray map = new SparseIntArray();
+        try {
+            Context c = ApplicationLoader.applicationContext;
+            // роли M3
+            int primary = isDark ? c.getColor(android.R.color.system_accent1_200) : c.getColor(android.R.color.system_accent1_600);
+            int container = isDark ? c.getColor(android.R.color.system_accent1_700) : c.getColor(android.R.color.system_accent1_100);
+            int containerHi = isDark ? c.getColor(android.R.color.system_accent1_600) : c.getColor(android.R.color.system_accent1_200);
+            int onContainer = isDark ? c.getColor(android.R.color.system_accent1_100) : c.getColor(android.R.color.system_accent1_900);
+            int onContainerVar = isDark ? c.getColor(android.R.color.system_accent1_200) : c.getColor(android.R.color.system_accent1_700);
+            int surface = isDark ? c.getColor(android.R.color.system_neutral1_900) : c.getColor(android.R.color.system_neutral1_10);
+            int surfaceDim = isDark ? c.getColor(android.R.color.system_neutral1_1000) : c.getColor(android.R.color.system_neutral1_50);
+
+            map.put(Theme.key_chats_actionBackground, container);
+            map.put(Theme.key_chats_actionPressedBackground, containerHi);
+            map.put(Theme.key_chats_actionIcon, onContainer);
+
+            map.put(Theme.key_windowBackgroundWhiteBlueText, primary);
+            map.put(Theme.key_windowBackgroundWhiteBlueHeader, primary);
+            map.put(Theme.key_dialogTextBlue, primary);
+            map.put(Theme.key_dialogButton, primary);
+            map.put(Theme.key_switchTrackChecked, primary);
+            map.put(Theme.key_switch2TrackChecked, primary);
+
+            map.put(Theme.key_chat_outBubble, container);
+            map.put(Theme.key_chat_outBubbleSelected, containerHi);
+            map.put(Theme.key_chat_messageTextOut, onContainer);
+            map.put(Theme.key_chat_outTimeText, onContainerVar);
+            map.put(Theme.key_chat_messageLinkOut, onContainerVar);
+
+            map.put(Theme.key_windowBackgroundWhite, surface);
+            map.put(Theme.key_windowBackgroundGray, surfaceDim);
+        } catch (Throwable t) {
+            FileLog.e(t);
+        }
+        if (isDark) {
+            dark = map;
+        } else {
+            light = map;
+        }
+        return map;
+    }
+}
